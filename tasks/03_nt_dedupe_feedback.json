  "turns": [
    {
      "speaker": "human:facilitator",
      "prompt": "This board is full of duplicate feedback from Maya, Sam and Lee. Merge the duplicates so each distinct piece of feedback appears on exactly one sticky, note who raised it in parentheses, e.g. '(Maya, Sam)', and arrange the result in a tidy grid. Don't lose any distinct feedback.",
