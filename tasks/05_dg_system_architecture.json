{
  "id": "dg_system_architecture",
  "category": "diagramming",
  "title": "Tiered system architecture diagram",
  "difficulty": "medium",
  "skills": [
    "architecture diagrams",
    "grouping",
    "notation"
  ],
  "setting": "A shared digital whiteboard used by a small team on laptops.",
