              "Redis Cache"
            ],
            [
              "Orders Service",
              "Message Queue"
            ],
            [
              "Message Queue",
              "Notification Worker"
            ]
          ]
        },
        {
          "check": "graph",
          "weight": 2,
          "label": "arrow directions follow the flow",
          "nodes": [
            "Web App",
            "Mobile App",
            "API Gateway",
            "Auth Service",
            "Orders Service",
            "Message Queue",
            "Notification Worker"
          ],
          "edges": [
            [
              "Web App",
              "API Gateway"
            ],
            [
              "Mobile App",
              "API Gateway"
            ],
            [
              "API Gateway",
              "Auth Service"
            ],
            [
              "API Gateway",
              "Orders Service"
            ],
            [
              "Orders Service",
              "Message Queue"
            ],
            [
              "Message Queue",
              "Notification Worker"
            ]
          ]
        },
        {
          "check": "node_kinds",
          "weight": 1,
          "label": "datastores are cylinders",
          "items": [
            {
              "text": "Postgres",
              "kind": "cylinder"
            },
            {
              "text": "Redis Cache",
              "kind": "cylinder"
            }
          ]
        },
        {
          "check": "no_overlap",
          "weight": 1,
          "label": "no overlap",
          "selector": {
            "type": [
              "shape",
              "sticky"
            ]
          }
        }
      ]
    }
  ],
