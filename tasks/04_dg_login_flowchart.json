        "args": {
          "kind": "rect",
          "x": 950,
          "y": 410,
          "w": 180,
          "h": 90,
          "text": "Show error"
        },
        "as": "err"
      },
      {
        "tool": "create_shape",
        "args": {
          "kind": "diamond",
          "x": 590,
          "y": 590,
          "w": 200,
          "h": 130,
          "text": "2FA enabled?"
