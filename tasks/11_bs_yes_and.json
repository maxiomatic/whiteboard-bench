    {
      "speaker": "human:facilitator",
      "prompt": "Build on each of these ideas: for every sticky the team added, add at least two 'yes, and...' stickies that extend it. Place them near the idea they build on, connect each one to its source, and use a different color from the originals.",
      "events": [],
      "checks": [
        {
          "check": "each_connected",
          "weight": 4,
          "label": "every idea has 2+ nearby builds connected",
          "from": {
            "type": "sticky",
            "author": "human"
          },
          "to": {
            "type": "sticky",
            "author": "agent"
          },
          "min": 2,
          "near": 450
        },
        {
          "check": "property",
          "weight": 1,
          "label": "builds use a different color",
          "items": [
            {
              "selector": {
                "type": "sticky",
                "author": "agent"
              },
              "field": "color",
              "value": "yellow",
              "op": "ne"
            }
          ]
        },
        {
          "check": "preserve_human",
          "weight": 1,
          "label": "original ideas untouched"
        },
        {
          "check": "max_words",
          "weight": 0.5,
          "label": "max words",
          "selector": {
            "type": "sticky",
            "author": "agent"
          },
          "max": 15
        },
        {
          "check": "no_overlap",
          "weight": 1,
          "label": "no overlap"
        },
        {
          "check": "rubric",
          "weight": 1,
          "label": "builds extend their source (judge)",
          "question": "Does each new sticky genuinely extend the specific idea it is connected to, rather than being generic or unrelated?"
        }
      ]
    }
  ],
