{
  "id": "bs_divergent_ideas",
  "category": "brainstorming",
  "title": "Divergent idea generation",
  "difficulty": "easy",
  "skills": [
    "ideation",
    "divergence"
  ],
  "setting": "A shared digital whiteboard used by a small team on laptops.",
  "participants": {
    "facilitator": {
      "name": "Alex",
      "note": "Runs the session."
    }
  },
  "board": {
    "width": 4000,
    "height": 3000
  },
  "initial_elements": [],
  "turns": [
    {
      "speaker": "human:facilitator",
      "prompt": "Brainstorm with me: ways a public library could attract more teenagers. Put at least 15 ideas as stickies inside a frame called 'Library x Teens', one idea per sticky. Make them varied, not rephrasings of the same idea.",
      "events": [],
      "checks": [
        {
          "check": "frames",
          "weight": 1,
          "label": "frames",
          "titles": [
            "Library x Teens"
          ]
        },
        {
          "check": "count",
          "weight": 2,
          "label": "at least 15 ideas in the frame",
          "selector": {
            "type": "sticky",
            "frame": "Library x Teens"
          },
          "min": 15
        },
        {
          "check": "distinct",
          "weight": 2,
          "label": "ideas are distinct",
          "selector": {
            "type": "sticky"
          },
          "min": 15
        },
        {
          "check": "max_words",
          "weight": 1,
          "label": "sticky-sized ideas",
          "selector": {
            "type": "sticky"
          },
          "max": 15
        },
        {
          "check": "no_overlap",
          "weight": 1,
          "label": "no overlap"
        },
        {
          "check": "rubric",
          "weight": 3,
          "label": "idea quality (judge)",
          "question": "Are the ideas varied rather than rephrasings, specific enough to act on, and plausible for a public library to try?"
        }
      ]
    }
  ],
  "final_checks": [],
  "max_calls_per_turn": 60,
  "efficient_calls": 36,
