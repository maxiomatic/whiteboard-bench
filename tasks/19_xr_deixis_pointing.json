            20
          ]
        }
      ],
      "checks": [
        {
          "check": "property",
          "weight": 1.5,
          "label": "recolored the pointed-at item",
          "items": [
            {
              "text": "Server capacity",
              "field": "color",
              "value": "red"
            }
          ]
        },
        {
          "check": "relation",
