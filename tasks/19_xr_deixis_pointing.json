          ]
        },
        {
          "check": "in_frame",
          "weight": 1,
          "label": "in frame",
          "items": [
            {
              "text": "Ship it Friday",
              "frame": "Launch checklist"
            }
          ]
        }
      ]
    },
    {
      "speaker": "human:maya",
      "prompt": "This one blocks that one. Connect them so it's obvious.",
      "events": [
        {
          "op": "point",
          "actor": "human:maya",
          "target": "Legal review pending",
          "jitter": [
            15,
            -10
          ]
        },
        {
          "op": "point",
          "actor": "human:maya",
          "target": "Press release",
          "jitter": [
            -20,
            5
          ]
        }
      ],
      "checks": [
        {
          "check": "graph",
          "weight": 3,
          "label": "blocker points at the blocked item",
          "nodes": [
            "Legal review pending",
            "Press release"
          ],
          "edges": [
            [
              "Legal review pending",
              "Press release"
            ]
          ]
        },
        {
          "check": "count",
          "weight": 1,
          "label": "no spurious connectors",
          "selector": {
            "type": "connector"
          },
          "max": 1
        }
      ]
    },
    {
      "speaker": "human:maya",
      "prompt": "Make this one red and move it over to the checklist, right next to QA.",
