        },
        {
          "check": "in_frame",
          "weight": 1,
          "label": "in frame",
          "items": [
            {
              "text": "Server capacity",
              "frame": "Launch checklist"
            }
          ]
        },
        {
          "check": "no_overlap",
          "weight": 1,
          "label": "no overlap"
        }
      ]
    }
  ],
  "final_checks": [],
  "max_calls_per_turn": 60,
  "efficient_calls": 14,
  "reference_solution": [
    [
      {
        "tool": "create_sticky",
