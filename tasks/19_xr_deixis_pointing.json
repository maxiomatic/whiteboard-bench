      "type": "sticky",
      "text": "Legal review pending",
      "x": 1200,
      "y": 450,
      "author": "human:facilitator",
      "color": "orange"
    }
  ],
  "turns": [
    {
      "speaker": "human:maya",
      "prompt": "Put a note right here that says 'Ship it Friday'.",
      "events": [
        {
          "op": "point",
          "actor": "human:maya",
          "at": [
            620,
            540
          ]
        }
      ],
      "checks": [
